# dependencies
/node_modules
.vercel

# downloaded subtitle files (not part of the app)
/subs

# webOS build artifact
*.ipk

# generated TV bundle (rebuild: npm run build:tv); served by the helper
/tv-bundle.js

# TV package output
/dist/

# Vercel prebuilt static output (rebuild: npm run build:web)
/public/

.env*
