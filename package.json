{
  "name": "movies-db",
  "version": "1.0.0",
  "description": "A movie browsing app using TMDB API",
  "type": "module",
  "scripts": {
    "start": "node stream-server.mjs",
    "serve": "npx serve .",
    "test": "node --test",
    "test-providers": "node provider-tester-cli.js",
    "check-links": "node check-links.mjs",
    "check-live": "node check-live.mjs",
    "check-playback": "xvfb-run -a --server-args=\"-screen 0 1280x720x24\" env CHECK_PLAYBACK=1 node --test check-playback.test.js",
    "check-fullscreen": "xvfb-run -a --server-args=\"-screen 0 1280x720x24\" env CHECK_FULLSCREEN=1 node --test fullscreen.test.js",
    "check-live-relay": "CHECK_LIVE_RELAY=1 node --test live-relay.integration.test.js",
    "check-popups": "xvfb-run -a --server-args=\"-screen 0 1280x720x24\" env CHECK_POPUPS=1 node --test check-popups.test.js",
    "build:tv": "esbuild tv-entry.js --bundle --format=iife --target=es2019 --outfile=tv-bundle.js",
    "prestart": "npm run build:tv",
    "test:tv": "TV_E2E=1 node --test --test-concurrency=1 tv-e2e.test.js tv-player-e2e.test.js tv-provider-popup.test.js",
    "package:tv": "npm run build:tv && ares-package webos-app --outdir dist",
    "build:web": "npm run build:tv && rm -rf public && mkdir -p public/webos-app && cp tv.css style.css tv-bundle.js public/ && cp webos-app/icon.png public/webos-app/icon.png && node scripts/version-web.mjs"
  },
  "keywords": [
    "movies",
    "tmdb",
    "frontend"
  ],
  "license": "MIT",
  "dependencies": {
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.61.1",
    "puppeteer": "^23.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
